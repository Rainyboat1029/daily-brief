# 本地测试用：复制成 .env 再填，别提交 .env（已在 .gitignore 里）
# 注意：GitHub Actions 不读这个文件，线上用的是仓库 Secrets。

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat

# 多个城市用逗号分隔
CITY=苏州,成都

# pushplus | feishu | email | none
PUSH_CHANNEL=pushplus
PUSHPLUS_TOKEN=
FEISHU_WEBHOOK=
FEISHU_SECRET=

SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_TO=

NEWS_LIMIT=24
LOOKBACK_HOURS=30
